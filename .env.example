# Groq API key — optional. Without it the assessment still works; only the LLM fallback
# (understanding unusual wording), the plain-language summary and voice input are disabled.
GROQ_API_KEY=
# Comma-separated Groq models tried in order (the old llama-3.x models were decommissioned).
LLM_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Set to 0 to disable all LLM calls.
MEDASSIST_LLM=1
LLM_TIMEOUT=20
# auto = multilingual embeddings + BM25 when sentence-transformers is installed, else BM25; lexical = BM25 only
RETRIEVAL_MODE=auto
# SQLite file for assessment state
MEDASSIST_DB=instance/assessments.db
# Fixed key so sessions survive restarts / multiple workers
SECRET_KEY=change-me
MAX_FOLLOWUPS=8
PORT=5001
